{
  "name": "space-chase-leaderboard",
  "private": true,
  "description": "Space Chase's family leaderboard: one Cloudflare Worker and a D1 database (free tier).",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply space-chase-leaderboard --local",
    "db:remote": "wrangler d1 migrations apply space-chase-leaderboard --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
